# Copy to .env and fill in. Never commit .env.

# NVIDIA API key (build.nvidia.com) — used for Nemotron Nano/Super endpoints.
NVIDIA_API_KEY=

# Optional fallback: OpenRouter key (answer agent falls back when set).
OPENROUTER_API_KEY=

# Optional: override the default models (see agent/answer.py, agent/diff.py).
# CLAUSEFINDER_MODEL=nvidia/nemotron-3-nano-30b-a3b
# CLAUSEFINDER_DIFF_MODEL=nvidia/nemotron-3-super-120b-a12b
